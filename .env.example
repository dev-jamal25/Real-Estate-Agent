# Environment Configuration for AI Real Estate Agent
# Copy to .env and fill in actual values

# FastAPI Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# LLM Configuration
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=openai

# ML Model Paths
MODEL_PATH=artifacts/best_model.pkl
PREPROCESSOR_PATH=artifacts/preprocessor.pkl
STATS_PATH=artifacts/stats.json

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Prompts
PROMPT_EXTRACT_V1_PATH=prompts/extract_v1.txt
PROMPT_EXTRACT_V2_PATH=prompts/extract_v2.txt
PROMPT_INTERPRET_V1_PATH=prompts/interpret_v1.txt
