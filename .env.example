# Environment Configuration for AI Real Estate Agent
# Copy to .env and fill in actual values
# Note: Tests use mock LLM by default; real API is optional

# FastAPI Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# LLM Configuration (Gemini - Primary)
# For testing/development: Set LLM_USE_MOCK=true (no API key needed)
# For production: Set LLM_USE_MOCK=false and provide GEMINI_API_KEY
# NOTE: Never commit actual API keys to version control
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash
LLM_USE_MOCK=true

# LLM Fallback Configuration (Ollama - Local Dev Only)
# Set LLM_ENABLE_FALLBACK=true to enable local Ollama fallback for Stage 1
# Fallback only happens on allowed provider errors (quota, timeout, 5xx)
# This is a temporary dev/local feature, not for production deployment
LLM_ENABLE_FALLBACK=false
LLM_FALLBACK_ON_QUOTA=true
LLM_FALLBACK_ON_TIMEOUT=true
LLM_FALLBACK_ON_5XX=true
# Ollama endpoint and model (local only)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=30

# ML Model Paths
MODEL_PATH=artifacts/model.joblib
PREPROCESSOR_PATH=artifacts/preprocessor.pkl
STATS_PATH=artifacts/stats.json

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log


